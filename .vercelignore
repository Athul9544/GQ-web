# The Node server, its tooling, and the admin portal are LOCAL only — Vercel has
# no writable disk to run them against. You publish by running the admin locally,
# then committing the result (see DEPLOY.md).
server.js
tools/
admin.html
assets/js/admin.js
assets/css/admin.css

